# Cloudflare Pages 响应头（与本地服务 server.js 的安全头保持一致）
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.anthropic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Permissions-Policy: microphone=(self), camera=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.deepseek.com https://api.moonshot.cn https://open.bigmodel.cn https://dashscope.aliyuncs.com https://api.siliconflow.cn https://ark.cn-beijing.volces.com https://openrouter.ai https://api.groq.com https://api.x.ai http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Permissions-Policy: microphone=(self), camera=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

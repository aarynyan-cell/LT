// Cloudflare Workers（静态资源 + 一个很小的中继）部署配置：Git 集成会执行 `npx wrangler deploy` 读取本文件。
// - 静态前端：lectureloop/app/public（安全响应头见其中的 _headers）
// - /relay：给"浏览器直连会被跨域拦截"的服务商用的同源中继（白名单主机，不记录密钥），代码见 lectureloop/app/worker/
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "lt",
  "main": "./lectureloop/app/worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./lectureloop/app/public",
    "binding": "ASSETS",
    "run_worker_first": ["/relay"]
  }
}
